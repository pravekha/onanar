MONGO_URL=mongodb://localhost:27017
DB_NAME=onanar

# Long, random secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins. Never use '*' — it is
# incompatible with the credentialed (cookie-based) auth requests.
CORS_ORIGINS=http://localhost:3000

# Seeded on first startup if no admin user exists yet.
ADMIN_EMAIL=admin@onanar.in
ADMIN_PASSWORD=admin123

# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none when serving over HTTPS
# with the frontend on a different origin than the backend.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
